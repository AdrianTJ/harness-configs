# Never let harness state or credentials into this repo. If a harness ever
# writes into a directory linked from here, these patterns catch it.
.credentials.json
auth.json
credentials.json
models.json
*.local.json
settings.local.json
session.json
sessions/
trust.json
history.jsonl
*.log

# Runtime lock files — omp writes config.yml.lock beside its config while saving
*.lock

# Extension/plugin build output
node_modules/
dist/
*.tsbuildinfo

# Backups — install.sh moves files aside as *.bak-<timestamp>, and tools like
# Orca write plain *.bak next to files they rewrite.
*.bak-*
*.bak

.DS_Store
