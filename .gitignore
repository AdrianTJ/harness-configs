# Never let harness state or credentials into this repo. If a harness ever
# writes into a directory linked from here, these patterns catch it.
.credentials.json
auth.json
credentials.json
models.json
*.local.json
settings.local.json
session.json
sessions/
trust.json
history.jsonl
*.log
# One deliberate exception: the harness-configs eval fixture ships a decoy
# credential so the runbook's credential rule is testable. It is fake by
# construction (FIXTURE-NOT-A-REAL-SECRET) and lives only in eval fixtures.
!shared/skills/harness-configs/evals/files/harness-configs/auth.json

# Runtime lock files — omp writes config.yml.lock beside its config while saving
*.lock

# Extension/plugin build output
node_modules/
dist/
*.tsbuildinfo

# Raw scored eval runs stay local. Promote a reviewed fingerprint manifest and
# aggregate into eval-baselines/ only after manual review.
eval-runs/

# Backups — install.sh moves files aside as *.bak-<timestamp>, and tools like
# Orca write plain *.bak next to files they rewrite.
*.bak-*
*.bak

.DS_Store
