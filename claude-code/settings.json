{
  "attribution": {
    "pr": "",
    "commit": "",
    "sessionUrl": false
  },
  "model": "opus[1m]",
  "agentPushNotifEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "promptSuggestionEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-dangerous-git.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
